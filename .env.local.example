# Copie para .env.local e preencha com os dados do seu projeto Supabase.
# (Supabase Dashboard -> Project Settings -> API)

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui

# Só para scripts server-side de admin (NUNCA expor no client). Opcional por enquanto.
# SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# Analytics opcional. Sem token, a integração fica completamente inativa.
# Prefira o projeto PostHog da região adequada à política de dados do negócio.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Chatwoot (widget do site) -------------------------------------------
# Só o que o browser pode ver. O widget é público por natureza: o token
# identifica a caixa de entrada, não autentica ninguém. Quem prova identidade é
# o `identifier_hash`, calculado no servidor a partir do hmac_token da inbox —
# esse, sim, nunca sai do backend.
# Sem estas duas, o widget simplesmente não sobe e o resto do app segue igual.
NEXT_PUBLIC_CHATWOOT_BASE_URL=
NEXT_PUBLIC_CHATWOOT_WEBSITE_TOKEN=

# --- Chatwoot (servidor) --------------------------------------------------
# NÃO ficam aqui. Vivem nos segredos das Edge Functions do Supabase
# (`supabase secrets set`), porque é lá que rodam — a Vercel só hospeda o app.
# Listadas para quem for configurar saber o que precisa existir:
#
#   CHATWOOT_BASE_URL              https://chat.exemplo.site
#   CHATWOOT_ACCOUNT_ID            id numérico da conta
#   CHATWOOT_API_TOKEN             token do agente de integração (Application API)
#   CHATWOOT_PLATFORM_TOKEN        token do PlatformApp (cria usuário sem e-mail)
#   CHATWOOT_WEBHOOK_SECRET        devolvido por POST /webhooks; assina o webhook
#   CHATWOOT_HMAC_TOKEN            hmac_token da inbox do widget
#   CHATWOOT_MARKETPLACE_INBOX_ID  inbox tipo `api` das conversas cliente↔profissional
#   CHATWOOT_WHATSAPP_INBOX_ID     inbox de WhatsApp (sem ela, o dispatch é no-op)
#   FRIOHUB_SITE_URL               prefixo dos links enviados nas notificações
#
# E dois no Vault do Postgres, usados pelo pg_cron para acordar o worker:
#   chatwoot_dispatch_url          URL da Edge Function chatwoot-dispatch
#   chatwoot_worker_key            chave usada no header Authorization

# --- Assistente de IA (OpenAI) --------------------------------------------
# Chave de produção da OpenAI, paga por uso — NÃO é a assinatura pessoal
# ChatGPT/Codex de ninguém do time. Sem ela, a rota /api/assistente/chat
# responde erro e a tela mostra aviso, sem quebrar o resto do painel.
# Liberado só no plano Master (plano_permite) + feature flag `assistente_ia`
# (nasce desligada — ver 20260828100000_assistente_ia_profissional.sql).
OPENAI_API_KEY=
OPENAI_ASSISTENTE_MODEL=
