# Copie para .env.local e preencha com os dados do seu projeto Supabase.
# (Supabase Dashboard -> Project Settings -> API)

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui

# Só para scripts server-side de admin (NUNCA expor no client). Opcional por enquanto.
# SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# Analytics opcional. Sem token, a integração fica completamente inativa.
# Prefira o projeto PostHog da região adequada à política de dados do negócio.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
